# --- Runtime ---
NODE_ENV=production
APP_URL=https://gade.uz

# --- Database (PostgreSQL on aHOST cPanel, localhost) ---
DATABASE_URL=postgresql://gade_app:CHANGE_ME@127.0.0.1:5432/gade_prod
DATABASE_POOL_MAX=5

# --- Cron (защита эндпоинтов /api/cron/*) ---
CRON_TOKEN=change_me_long_random_string

# --- Billz (POS) ---
# Секретный ключ интеграции из BILLZ UI (Настройки → Интеграции)
BILLZ_SECRET_TOKEN=
# ID магазина, с которого показываем товары/остатки/цены (Mirabad Avenue)
BILLZ_SHOP_ID=ba8e1f51-f754-4a9e-917f-5951e10ad216

# --- Bitrix24 ---
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/xxxxxx/
BITRIX_INBOUND_TOKEN=change_me

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDERS_CHAT_ID=
TELEGRAM_TECH_CHAT_ID=

# --- SMS: Eskiz.uz ---
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# --- Payments ---
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# --- Monitoring ---
SENTRY_DSN=

# --- Admin panel ---
ADMIN_LOGIN=admin
# Сгенерировать: npm run admin:hash-password "мой_пароль"
# ВАЖНО: экранируйте знаки $ в хэше как \$ — Next.js env-парсер иначе интерпретирует их как переменные
ADMIN_PASSWORD_HASH=scrypt\$04454d49cf931ddcb41792021d8e201f\$d572d237becd323029b0dc47901c7a9664373a3057d771aaa6d842ab9280558a8aafa3d21790a1bcc05b45598b2a4f38894ef5de63f39639af60307b73c43273
# Не менее 32 символов. Смена секрета инвалидирует все сессии
ADMIN_SESSION_SECRET=change_me_at_least_32_characters_long
